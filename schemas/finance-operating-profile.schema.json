{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Finance operating profile",
  "description": "Artifacts are local drafts only; missing is never zero.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entity",
    "timezone",
    "currency",
    "minor_units",
    "basis",
    "fiscal_calendar",
    "materiality_policy",
    "reporting_cadence",
    "tenant_confirmed"
  ],
  "properties": {
    "entity": {
      "type": "string",
      "minLength": 1
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "minor_units": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    },
    "basis": {
      "enum": [
        "cash",
        "accrual"
      ]
    },
    "fiscal_calendar": {
      "type": "string",
      "minLength": 1
    },
    "materiality_policy": {
      "type": "string",
      "minLength": 1
    },
    "reporting_cadence": {
      "type": "string",
      "minLength": 1
    },
    "tenant_confirmed": {
      "const": true
    }
  }
}
