{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "13-week cash forecast",
  "description": "Artifacts are local drafts only; missing is never zero.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entity",
    "period_start",
    "period_end",
    "as_of",
    "timezone",
    "currency",
    "minor_units",
    "accounting_basis",
    "sources",
    "source_coverage",
    "freshness",
    "reconciliation_status",
    "scenario",
    "opening_cash",
    "weeks",
    "unexecuted"
  ],
  "properties": {
    "entity": {
      "type": "string",
      "minLength": 1
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "as_of": {
      "type": "string",
      "minLength": 1
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "minor_units": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    },
    "accounting_basis": {
      "enum": [
        "cash",
        "accrual"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "source_coverage": {
      "type": "string",
      "minLength": 1
    },
    "freshness": {
      "type": "string",
      "minLength": 1
    },
    "reconciliation_status": {
      "enum": [
        "reconciled",
        "unreconciled",
        "not_tested",
        "partial"
      ]
    },
    "scenario": {
      "type": "string",
      "minLength": 1
    },
    "opening_cash": {
      "type": "string",
      "pattern": "^[+-]?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "weeks": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "week",
          "week_start",
          "opening_cash",
          "receipts",
          "disbursements",
          "closing_cash"
        ],
        "properties": {
          "week": {
            "type": "integer",
            "minimum": 1,
            "maximum": 13
          },
          "week_start": {
            "type": "string",
            "format": "date"
          },
          "opening_cash": {
            "type": "string",
            "pattern": "^[+-]?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
          },
          "receipts": {
            "type": "string",
            "pattern": "^[+-]?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
          },
          "disbursements": {
            "type": "string",
            "pattern": "^[+-]?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
          },
          "closing_cash": {
            "type": "string",
            "pattern": "^[+-]?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
          }
        }
      }
    },
    "unexecuted": {
      "const": true
    }
  }
}
