{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AR/AP plan",
  "description": "Artifacts are local drafts only; missing is never zero.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entity",
    "period_start",
    "period_end",
    "as_of",
    "timezone",
    "currency",
    "minor_units",
    "accounting_basis",
    "sources",
    "source_coverage",
    "freshness",
    "reconciliation_status",
    "plan_type",
    "items",
    "unexecuted"
  ],
  "properties": {
    "entity": {
      "type": "string",
      "minLength": 1
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "as_of": {
      "type": "string",
      "minLength": 1
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "minor_units": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    },
    "accounting_basis": {
      "enum": [
        "cash",
        "accrual"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "source_coverage": {
      "type": "string",
      "minLength": 1
    },
    "freshness": {
      "type": "string",
      "minLength": 1
    },
    "reconciliation_status": {
      "enum": [
        "reconciled",
        "unreconciled",
        "not_tested",
        "partial"
      ]
    },
    "plan_type": {
      "enum": [
        "AR",
        "AP"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "redacted_id",
          "amount",
          "status",
          "priority_reason"
        ],
        "properties": {
          "redacted_id": {
            "type": "string",
            "minLength": 1
          },
          "amount": {
            "type": "string",
            "pattern": "^[+-]?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "priority_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "unexecuted": {
      "const": true
    }
  }
}
