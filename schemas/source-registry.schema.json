{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source registry",
  "description": "Artifacts are local drafts only; missing is never zero.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entity",
    "sources"
  ],
  "properties": {
    "entity": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_type",
          "owner",
          "location",
          "period",
          "as_of",
          "basis",
          "currency",
          "coverage",
          "freshness"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "period": {
            "type": "string",
            "minLength": 1
          },
          "as_of": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "enum": [
              "cash",
              "accrual",
              "not_applicable"
            ]
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "coverage": {
            "type": "string",
            "minLength": 1
          },
          "freshness": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
